# ============================================================================
# StarTech RAG API - Configuration
# ============================================================================

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# LLM Service Type: "ollama", "otoroshi", "openai", "mock"
LLM_SERVICE_TYPE=ollama

# Configuration LLM Otoroshi
OTOROSHI_API_URL=https://your-otoroshi-service.com/api
OTOROSHI_API_KEY=your-api-key-here

# Configuration Ollama (Recommandé pour le développement local)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Configuration OpenAI (fallback)
OPENAI_API_KEY=your-openai-key-here

# Configuration Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Configuration ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Configuration Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO
